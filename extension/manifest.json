{
  "manifest_version": 3,
  "name": "Onrush — coût matière et food cost",
  "version": "1.0.0",
  "homepage_url": "https://cyrilquesnel.github.io/onrush-food-cost/",
  "description": "Calculez localement le coût matière par portion et la marge de vos recettes. Sans compte ni accès à vos sites.",
  "action": { "default_title": "Ouvrir le calculateur Onrush", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
